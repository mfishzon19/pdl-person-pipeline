# Local development environment variables.
#
# Copy this file to .env (which is gitignored) and source it into your
# shell at the start of each session:
#
#   set -a; source .env; set +a
#
# The leading `set -a` auto-exports every var the file sets; the trailing
# `set +a` turns auto-export off again.
#
# What needs these:
#   DATABASE_URL  — Python ingester, PDL API callers, ad-hoc psycopg2
#                   scripts. NOT dbt: profiles.yml resolves DBT_PG_*
#                   (local target), never DATABASE_URL.
#   AWS_*         — boto3 (Finder lists S3, Loader downloads files). For
#                   local runs these point at the docker-compose MinIO.
#
# What does NOT need these (reads modeling/flyway/flyway.conf instead):
#   - plain `flyway -configFiles=modeling/flyway/flyway.conf migrate`
#   - the flyway-init compose service (`make dev-up`)

# psycopg2 connection string for the local Docker Postgres
# (see docker-compose.yml + modeling/flyway/flyway.conf — same creds).
DATABASE_URL=postgresql://pdl_etl:pdl_etl_dev@localhost:5432/pdl_etl

# S3 endpoint + credentials. Defaults target the local MinIO started by
# `make dev-up-ingester` (compose `ingester` profile). To read a real PDL
# delivery bucket instead, unset AWS_ENDPOINT_URL and supply real AWS
# credentials (or AWS_PROFILE) with read access to that bucket.
AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minio_local
AWS_SECRET_ACCESS_KEY=minio_local_dev
AWS_DEFAULT_REGION=us-east-1

# dbt local target (processing/dbt/profiles.yml). These match the
# profile's built-in localhost defaults; override only if you changed
# the compose credentials or port.
DBT_PG_HOST=localhost
DBT_PG_PORT=5432
DBT_PG_USER=pdl_etl
DBT_PG_PASSWORD=pdl_etl_dev
DBT_PG_DBNAME=pdl_etl

# PDL API key for the company enrichment + cleaner callers
# (processing/pdl_api). Read from the environment only — never commit it.
# Leave unset to keep everything offline (tests mock all PDL calls).
# PDL_API_KEY=

# Optional: URL of a sanitized PDL fixture (.csv.gz) that `make dev-up`'s
# fixture-load service downloads and seeds into raw.pdl_person / MinIO.
# Unset → fixture-load uses infra/local/fixtures-cache/ if present, else
# skips. See infra/local/scripts/fixture-load.sh.
# FIXTURE_URL=
